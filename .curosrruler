{
  "rules": [
    // Regras de Nomenclatura
    {
      "group": "naming",
      "rules": [
        {
          "name": "Controller Naming",
          "pattern": ".*Controller$",
          "description": "Controllers devem ter o sufixo 'Controller'",
          "severity": "error"
        },
        {
          "name": "Model Naming",
          "pattern": "^[A-Z][a-zA-Z0-9]*$",
          "description": "Models devem usar PascalCase",
          "severity": "error"
        },
        {
          "name": "View Naming",
          "pattern": ".*\\.blade\\.php$",
          "description": "Views devem usar extensão .blade.php",
          "severity": "error"
        },
        {
          "name": "Method Naming",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "description": "Métodos devem usar camelCase",
          "severity": "error"
        },
        {
          "name": "Database Naming",
          "pattern": "^[a-z_]+$",
          "description": "Banco de dados deve usar snake_case",
          "severity": "error"
        }
      ]
    },

    // Regras de Layout e UI
    {
      "group": "layout",
      "rules": [
        {
          "name": "Layout Structure",
          "pattern": ".*\\.blade\\.php$",
          "description": "Views devem seguir estrutura hierárquica: cabeçalho fixo, menu lateral e conteúdo principal",
          "severity": "error"
        },
        {
          "name": "Header Pattern",
          "pattern": ".*\\.blade\\.php$",
          "description": "Cabeçalho deve ter altura 64px, posição fixa e z-index adequado",
          "severity": "error"
        },
        {
          "name": "Content Padding",
          "pattern": ".*\\.blade\\.php$",
          "description": "Conteúdo principal deve ter padding-top 100px e padding-left 380px",
          "severity": "error"
        },
        {
          "name": "Materialize Usage",
          "pattern": ".*\\.blade\\.php$",
          "description": "Usar componentes do Materialize CSS com ícones adequados",
          "severity": "error"
        },
        {
          "name": "Responsive Design",
          "pattern": ".*\\.blade\\.php$",
          "description": "Implementar media queries para responsividade em telas menores",
          "severity": "error"
        }
      ],
      "materialize": {
        "select_pattern": {
          "description": "Padrão para implementação de selects do Materialize",
          "css_required": {
            "class": "select-field",
            "styles": [
              ".select-field { margin-bottom: 0 !important; }",
              ".select-field .select-wrapper input.select-dropdown {",
              "    height: 2rem !important;",
              "    line-height: 2rem !important;",
              "    font-size: 14px !important;",
              "    border-bottom: 1px solid #9e9e9e !important;",
              "}",
              ".select-field .select-wrapper .dropdown-content { top: auto !important; }",
              ".select-field .select-wrapper .dropdown-content li > span {",
              "    font-size: 14px;",
              "    padding: 8px 16px;",
              "}",
              ".select-field .helper-text { margin-top: 0; font-size: 12px; }"
            ]
          },
          "html_structure": {
            "template": [
              "<div class=\"input-field col s12 m6 select-field\">",
              "    <select name=\"field_name\" id=\"field_name\">",
              "        <option value=\"\" disabled selected>Selecione...</option>",
              "        @foreach($items as $item)",
              "            <option value=\"{{ $item->id }}\" {{ (old('field_name', $model->field_name ?? '') == $item->id) ? 'selected' : '' }}>",
              "                {{ $item->nome }}",
              "            </option>",
              "        @endforeach",
              "    </select>",
              "    <label for=\"field_name\">Label do Campo</label>",
              "    @error('field_name') <span class=\"red-text\">{{ $message }}</span> @enderror",
              "</div>"
            ]
          },
          "javascript_required": {
            "initialization": [
              "document.addEventListener('DOMContentLoaded', function() {",
              "    var selects = document.querySelectorAll('select');",
              "    var selectInstances = M.FormSelect.init(selects, {",
              "        dropdownOptions: {",
              "            container: document.body,",
              "            constrainWidth: false",
              "        }",
              "    });",
              "",
              "    selects.forEach(function(select) {",
              "        select.addEventListener('change', function() {",
              "            var selectedValue = this.value;",
              "            var selectedText = this.options[this.selectedIndex].text;",
              "            ",
              "            setTimeout(function() {",
              "                var instance = M.FormSelect.init(select);",
              "                select.value = selectedValue;",
              "                instance.input.value = selectedText;",
              "            }, 100);",
              "        });",
              "    });",
              "});"
            ]
          },
          "examples": {
            "basic_select": {
              "description": "Exemplo de implementação básica de select",
              "code": [
                "<div class=\"input-field col s12 m6 select-field\">",
                "    <select name=\"tipo\" id=\"tipo\" required>",
                "        <option value=\"\" disabled selected>Selecione o tipo</option>",
                "        @foreach($tipos as $key => $value)",
                "            <option value=\"{{ $key }}\">{{ $value }}</option>",
                "        @endforeach",
                "    </select>",
                "    <label for=\"tipo\">Tipo</label>",
                "</div>"
              ]
            }
          },
          "observations": [
            "1. Sempre usar a classe 'select-field' no container do select",
            "2. Incluir os estilos CSS no início do arquivo blade ou em um arquivo CSS global",
            "3. Inicializar os selects com o JavaScript fornecido no @push('scripts')",
            "4. Manter a estrutura HTML conforme o template para garantir consistência"
          ]
        }
      }
    },

    // Regras de Arquitetura
    {
      "group": "architecture",
      "rules": [
        {
          "name": "MVPS Pattern",
          "pattern": ".*",
          "description": "Seguir o padrão MVPS (Materialize View Pattern System)",
          "severity": "error"
        },
        {
          "name": "Service Layer",
          "pattern": ".*Service$",
          "description": "Lógica de negócio deve estar em Services",
          "severity": "error"
        },
        {
          "name": "Repository Pattern",
          "pattern": ".*Repository$",
          "description": "Acesso a dados deve usar Repositories",
          "severity": "error"
        },
        {
          "name": "Form Requests",
          "pattern": ".*Request$",
          "description": "Validações devem usar Form Requests",
          "severity": "error"
        }
      ]
    },

    // Regras de Código
    {
      "group": "code",
      "rules": [
        {
          "name": "PSR-12",
          "pattern": ".*\\.php$",
          "description": "Seguir padrão PSR-12 para formatação",
          "severity": "error"
        },
        {
          "name": "Error Handling",
          "pattern": ".*Controller.*",
          "description": "Usar try-catch com logs apropriados",
          "severity": "error"
        },
        {
          "name": "Documentation",
          "pattern": ".*\\.php$",
          "description": "Documentar métodos com PHPDoc",
          "severity": "warning"
        }
      ]
    },

    // Regras de Banco de Dados
    {
      "group": "database",
      "rules": [
        {
          "name": "Migrations",
          "pattern": "^[0-9]+_.*\\.php$",
          "description": "Usar migrations para alterações no banco",
          "severity": "error"
        },
        {
          "name": "Eloquent Usage",
          "pattern": ".*Model.*",
          "description": "Usar Eloquent ORM para operações no banco",
          "severity": "error"
        }
      ]
    },

    // Regras de Testes
    {
      "group": "testing",
      "rules": [
        {
          "name": "Test Coverage",
          "pattern": ".*Test\\.php$",
          "description": "Mínimo de 80% de cobertura em funcionalidades críticas",
          "severity": "error"
        },
        {
          "name": "Feature Tests",
          "pattern": ".*Test\\.php$",
          "description": "Implementar testes de feature para fluxos principais",
          "severity": "error"
        }
      ]
    },

    // Regras de Segurança
    {
      "group": "security",
      "rules": [
        {
          "name": "Environment Config",
          "pattern": ".*\\.env$",
          "description": "Dados sensíveis devem estar no .env",
          "severity": "error"
        },
        {
          "name": "CSRF Protection",
          "pattern": ".*\\.blade\\.php$",
          "description": "Forms devem incluir token CSRF",
          "severity": "error"
        }
      ]
    }
  ]
}
